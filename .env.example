# PostgreSQL Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=coal_logistics_compliance
POSTGRES_USER=coal_logistics
POSTGRES_PASSWORD=coal_logistics_secure_password_2024

# Application Configuration
NODE_ENV=production
PORT=3000

# n8n Webhook Configuration
# If using coal-n8n container on same network
N8N_WEBHOOK_URL=http://coal-n8n:5678/webhook/job-created
# Or use external n8n instance
# N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/job-created

# Webhook Security
WEBHOOK_SECRET=your_webhook_secret_here

# n8n Configuration (if running n8n in this stack)
N8N_USER=admin
N8N_PASSWORD=admin
